# Copy this file to .env in the project root.
# Leave a value empty to keep the built-in mock for that integration.

PORT=8000
# Leave this unset for local runs. The API then uses backend/veriduka.db.
# Docker Compose sets its own path at /data/veriduka.db.
# DATABASE_URL=sqlite:///./veriduka.db

# ThriveVas SMS. https://docs.thrivevas.com/
# The key is sent as the x-api-key header to POST /v1/message/send.
# THRIVEWAVE_LIVE=false keeps the on-page reply and does not call ThriveVas.
THRIVEVAS_API_KEY=
THRIVEVAS_SENDER_ID=ThriveVas
THRIVEVAS_SMS_URL=https://sms.thrivevas.com/v1/message/send
THRIVEWAVE_CALLBACK_URL=
THRIVEWAVE_LIVE=false

# Instagram comments for a shop that has authorized this Meta app.
# Create an app at https://developers.facebook.com/ and ask the shop to connect
# its Instagram professional account. VeriDuka then reads comments on that
# account's own posts. It does not read accounts that have not authorized it.
META_GRAPH_VERSION=v21.0
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# WhatsApp Business (Meta Cloud API) for a shop that connects its own number.
# Point the Meta webhook at /api/v1/whatsapp/webhook. VERIFY_TOKEN is the string
# you type into Meta's webhook setup. APP_SECRET, when set, makes VeriDuka reject
# unsigned deliveries. Connect a shop with POST /api/v1/whatsapp/connect.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional live registry adapters. Empty means the bundled BRS and KRA mock.
KRA_API_URL=
KRA_API_KEY=
BRS_API_URL=
BRS_API_KEY=

# Safaricom Daraja. Leave both keys empty to keep the seeded M-Pesa badge.
# With keys, Recheck calls Query Organization Info for the name on the short code.
# The badge turns on only when that name matches the KRA/BRS entity.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_ENVIRONMENT=sandbox
# Optional. Default is /mpesa/orginfo/v1/query on the sandbox or production host.
# The body is {"ShortCode":"<paybill>"}. The name is read from OrganizationName or MerchantName.
DARAJA_NAME_LOOKUP_URL=

# Optional. When set, resolving a report needs this value in the X-Review-Key header.
REVIEW_API_KEY=
