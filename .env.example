# Copy this file to .env in the project root.
# Leave a value empty to keep the built-in mock for that integration.

PORT=8000
# Leave this unset for local runs. The API then uses backend/veriduka.db.
# Docker Compose sets its own path at /data/veriduka.db.
# DATABASE_URL=sqlite:///./veriduka.db

# ThriveWave SMS. THRIVEWAVE_LIVE=false returns a mock dispatch receipt.
THRIVEWAVE_API_URL=https://api.thrivewave.mock/v1
THRIVEWAVE_API_KEY=
THRIVEWAVE_SENDER_ID=VERIDUKA
THRIVEWAVE_CALLBACK_URL=
THRIVEWAVE_LIVE=false

# Instagram comments for a shop that has authorized this Meta app.
# Create an app at https://developers.facebook.com/ and ask the shop to connect
# its Instagram professional account. VeriDuka then reads comments on that
# account's own posts. It does not read accounts that have not authorized it.
META_GRAPH_VERSION=v21.0
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Optional live registry adapters. Empty means the bundled BRS and KRA mock.
KRA_API_URL=
KRA_API_KEY=
BRS_API_URL=
BRS_API_KEY=

# Optional Safaricom Daraja credentials for a future till-name check.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_ENVIRONMENT=sandbox

# Optional. When set, resolving a report needs this value in the X-Review-Key header.
REVIEW_API_KEY=
